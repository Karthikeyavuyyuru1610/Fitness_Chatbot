# Backend Configuration
PORT=5000
NODE_ENV=production

# Security & Secrets
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Storage
DB_PATH=./data/fitness_bot.db

# CORS Allowed Origins (Optional - comma separated origins or * for all)
CORS_ORIGIN=*

# Frontend Configuration (Optional: Only if deploying frontend separately)
# VITE_API_BASE_URL=https://your-fitness-bot-backend.onrender.com/api
